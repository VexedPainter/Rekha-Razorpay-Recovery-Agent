# Razorpay TEST MODE credentials.
#
# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is gitignored and never committed.
#
# TEST MODE ONLY. Never put live/production keys in here.
#
# Where to get these:
#   1. Log in at https://dashboard.razorpay.com
#   2. Switch the toggle at the top to "Test Mode"
#   3. Settings -> API Keys -> Generate Test Key
#   4. Copy the Key Id and Key Secret below
#      (the secret is shown only once -- if you lose it, generate a new one)

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Any string you like. Only used later, to verify webhook signatures.
RAZORPAY_WEBHOOK_SECRET=pick-any-string-for-now

# Needed from Phase 5 onward (the AI layer). Leave as-is for now if you
# don't have it yet -- nothing before Phase 5 uses it.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
