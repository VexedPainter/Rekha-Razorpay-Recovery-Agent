# Credentials. Copy this file to `.env` (same folder) and fill in what you have.
#
# `.env` is gitignored; this template is tracked. Nothing here is required to run
# the project: with no keys at all it uses the offline sandbox and recorded
# fixtures, and the full test suite passes.
#
# TEST MODE ONLY. Never put live/production Razorpay keys in here.

# ---------------------------------------------------------------------------
# LLM provider -- pick ONE. Free options first.
# ---------------------------------------------------------------------------
#
# The recovery agent needs a model to diagnose failed payments. Providers are
# interchangeable (see recovery/providers/); selection takes the first key
# present, in the order below, so free tiers win by default.
#
# GEMINI (recommended -- genuinely free, no credit card)
#   1. Go to https://aistudio.google.com/apikey
#   2. Sign in with a Google account
#   3. "Create API key" -> copy it
#   4. Paste below, uncomment the line
#
# GEMINI_API_KEY=AIza...
#
# Optional: override the model. Defaults to gemini-3.6-flash.
# GEMINI_MODEL=gemini-3.5-flash-lite

# GROQ (also free, no card, very fast -- https://console.groq.com/keys)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# ANTHROPIC (paid: $5 minimum credit purchase; actual usage is cents)
# The on-brand choice -- Razorpay Agent Studio is built on Anthropic's Claude
# Agent SDK -- but entirely optional. https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Force a specific provider regardless of which keys are present.
# `replay` uses recorded fixtures only and never touches a network.
# RECOVERY_PROVIDER=replay

# ---------------------------------------------------------------------------
# Razorpay TEST MODE
# ---------------------------------------------------------------------------
#
# Only needed for `belay recover --live`. Everything else runs against
# examples/razorpay-sandbox with no credentials.
#
#   1. https://dashboard.razorpay.com -> switch the toggle to "Test Mode"
#   2. Settings -> API Keys -> Generate Test Key
#   3. Copy both values (the secret is shown only once)

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Any string you like. Used to verify webhook signatures (Phase 7).
RAZORPAY_WEBHOOK_SECRET=pick-any-string-for-now
